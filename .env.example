# 디스코드 봇
BOT_TOKEN=봇_토큰

# 봇 소유자 ID (개발자 모드로 본인 ID 복사)
OWNER_ID=본인_디스코드_ID

# 관리자 채널 (선택)
ADMIN_CHANNEL_ID=채널_ID

# SMS 웹훅
SMS_PORT=3000
# 자동충전 API 키: 이제 웹 대시보드 Settings 에서 설정 가능 (웹 설정값이 우선, 이 값은 선택/예비용)
# SMS_WEBHOOK_SECRET=비밀키아무거나

# 웹 대시보드
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASS=비밀번호설정
DASHBOARD_SECRET=랜덤문자열

# Render 배포용
# DATA_DIR=/data            # Persistent Disk를 /data에 마운트했다면 (없으면 재배포 때 데이터 삭제됨)
# PORT는 Render가 자동으로 넣어줌 → 대시보드와 /sms 가 같은 포트로 열림
